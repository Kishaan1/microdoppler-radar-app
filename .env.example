# Copy to .env and fill in for local development.
# Never commit a real .env file.

FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=postgresql://radar_user:radar_pass@localhost:5432/radar_db
RADAR_STREAM_HZ=10
CLASSIFICATION_PERSIST_EVERY_N=10
PORT=5000

# Optional: Redis URL for Flask-SocketIO message queue when running
# multiple gunicorn/eventlet workers or multiple app instances behind a
# load balancer (e.g. AWS ECS with >1 task, Render with >1 instance).
# REDIS_URL=redis://localhost:6379/0
